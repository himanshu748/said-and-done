{
  "name": "said-and-done",
  "version": "0.1.0",
  "description": "Forge app for Jira and Confluence that turns promises written in comments and pages into tracked follow-ups.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p static/ui/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build:ui": "vite build --config static/ui/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/bridge": "^7.3.0",
    "@forge/events": "^3.0.10",
    "@forge/kvs": "^2.1.2",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
